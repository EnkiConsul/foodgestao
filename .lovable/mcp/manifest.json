{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://grtxmbffgmgnkawlvqhm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "360-food",
      "version": "0.1.0",
      "title": "Aveto 360"
    },
    "tools": [
      {
        "name": "list_companies",
        "title": "Listar empresas",
        "description": "Lista as empresas (perfis PJ) que o usuário conectado pode acessar no Aveto 360.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_accounts",
        "title": "Listar contas e saldos",
        "description": "Lista as contas bancárias/caixa com o saldo atual. Opcionalmente filtra por empresa (company_id) ou contexto PF/PJ.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtra pelas contas de uma empresa (PJ)."
            },
            "context": {
              "type": "string",
              "enum": [
                "pf",
                "pj"
              ],
              "description": "Contexto: pessoal (pf) ou empresarial (pj)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "Listar lançamentos",
        "description": "Lista lançamentos financeiros (entradas, saídas, contas a pagar/receber) com filtros de período, empresa, tipo e situação.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "Filtra por empresa (PJ)."
            },
            "context": {
              "type": "string",
              "enum": [
                "pf",
                "pj"
              ],
              "description": "Contexto: pessoal (pf) ou empresarial (pj)."
            },
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data inicial (transaction_date)."
            },
            "end_date": {
              "$ref": "#/properties/start_date",
              "description": "Data final (transaction_date)."
            },
            "transaction_type": {
              "type": "string",
              "enum": [
                "entrada",
                "saida",
                "transferencia",
                "parcelado"
              ],
              "description": "Tipo do lançamento."
            },
            "status": {
              "type": "string",
              "enum": [
                "pendente",
                "confirmado",
                "cancelado"
              ],
              "description": "Situação do lançamento."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Máximo de registros (1-200)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_colaboradores",
        "title": "Listar colaboradores (Pessoas 360°)",
        "description": "Lista os colaboradores de uma empresa no módulo Pessoas 360°, com cargo, unidade, vínculo e situação.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "format": "uuid",
              "description": "Empresa (PJ) dos colaboradores."
            },
            "apenas_ativos": {
              "type": "boolean",
              "default": true,
              "description": "Quando verdadeiro, retorna somente colaboradores ativos."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100,
              "description": "Máximo de registros (1-200)."
            }
          },
          "required": [
            "company_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
